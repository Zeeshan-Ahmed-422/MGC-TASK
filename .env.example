# Copy this file to .env and paste your key in. .env is gitignored.
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env

# Which LLM provider to use: gemini | openai | anthropic
LLM_PROVIDER=gemini

# ---- Google AI Studio (default) -------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# MODEL may be a comma-separated fallback chain, tried left to right. The free tier caps
# each model separately (20 requests/day on gemini-3.5-flash while I was building) and
# they differ in speed a lot - 3.5-flash answers in under 2s, the lite model takes ~10s.
# So: fast one first, dependable one second. A single model name works fine too.
MODEL=gemini-3.5-flash,gemini-3.1-flash-lite

# ---- OpenAI --------------------------------------------------------------
# Set LLM_PROVIDER=openai and MODEL=gpt-4o-mini
OPENAI_API_KEY=

# ---- Anthropic -----------------------------------------------------------
# Set LLM_PROVIDER=anthropic and MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
