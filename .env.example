# Copy this file to .env and paste your key in. .env is gitignored.
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env

# Which LLM provider to use: gemini | openai | anthropic
LLM_PROVIDER=gemini

# ---- Google AI Studio (default) -------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
MODEL=gemini-3.1-flash-lite

# ---- OpenAI --------------------------------------------------------------
# Set LLM_PROVIDER=openai and MODEL=gpt-4o-mini
OPENAI_API_KEY=

# ---- Anthropic -----------------------------------------------------------
# Set LLM_PROVIDER=anthropic and MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
